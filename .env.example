// Supabase credentials
NEXT_PUBLIC_SUPABASE_URL=https://gpwauatdiafcvlqvklhn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=SupabaseAnonKeyHere
SUPABASE_SERVICE_ROLE_KEY=SupabaseServiceRoleKeyHere

# MyAnimeList API v2 (server-side only)
MAL_CLIENT_ID=your_myanimelist_client_id
MAL_CLIENT_SECRET=your_myanimelist_client_secret
MAL_REDIRECT_URI=http://localhost:3000/api/mal/callback
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MAL_TOKEN_ENCRYPTION_KEY=your_32_byte_base64_key

# AniList OAuth (server-side only)
ANILIST_CLIENT_ID=your_anilist_client_id
ANILIST_CLIENT_SECRET=your_anilist_client_secret
ANILIST_REDIRECT_URI=http://localhost:3000/api/anilist/callback
# Generate a separate 32-byte Base64 key, as shown below for MAL.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ANILIST_TOKEN_ENCRYPTION_KEY=your_32_byte_base64_key
ANILIST_SYNC_WORKER_SECRET=your_random_worker_secret
ANILIST_SYNC_APP_URL=http://localhost:3000

# Enable after applying 202610220001_library_multiselect_filters.sql
LIBRARY_FILTERS_RPC_ENABLED=false
