# MyAnimeList API v2 (server-side only)
MAL_CLIENT_ID=your_myanimelist_client_id
MAL_CLIENT_SECRET=your_myanimelist_client_secret
MAL_REDIRECT_URI=http://localhost:3000/api/mal/callback

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MAL_TOKEN_ENCRYPTION_KEY=your_32_byte_base64_key

# Server-side only. Never expose this value with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key